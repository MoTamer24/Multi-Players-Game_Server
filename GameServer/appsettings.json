{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=gameserver.db"
  },
  "Jwt": {
    "Issuer": "GameServer",
    "Audience": "gameserver",
    "ExpireMinutes": 1440
  },
  "Guest": {
    "DefaultLifetimeMinutes": 60
  },
  "User":{
    "DefaultLifetimeMinutes":1440
  }
  ,
  "Google": {
    "ClientId": "${GOOGLE_CLIENT_ID}"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}